{
  "name": "impera-silence-remover",
  "version": "1.0.0",
  "description": "IMPERA AUTOMATION — Silence Remover Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.impera.silence-remover",
    "productName": "IMPERA Silence Remover",
    "copyright": "© 2026 IMPERA AUTOMATION",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "splash.html",
      "app.html"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IMPERA Silence Remover"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jimp": "^1.6.1",
    "png2icons": "^2.0.1"
  }
}
