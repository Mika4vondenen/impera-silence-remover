{
  "name": "impera-silence-remover",
  "version": "1.0.0",
  "description": "IMPERA AUTOMATION — Silence Remover Tool",
  "main": "main.js",
  "author": "IMPERA AUTOMATION",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:all": "electron-builder --win --mac --publish never"
  },
  "build": {
    "appId": "com.impera.silence-remover",
    "productName": "IMPERA Silence Remover",
    "copyright": "© 2026 IMPERA AUTOMATION",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "app.html"
    ],
    "extraResources": [],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IMPERA Silence Remover"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ]
    },
    "dmg": {
      "title": "IMPERA Silence Remover",
      "contents": [
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 130, "y": 150, "type": "file" }
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jimp": "^1.6.1",
    "png2icons": "^2.0.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "three": "^0.184.0"
  }
}
